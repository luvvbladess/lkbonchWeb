# Скопируйте в .env. Файл .env в git не входит.
# Коле его можно отдать лично. В образ Docker эти значения не зашиваются.

POSTGRES_USER=lkbonch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lkbonch

# Хост db — имя сервиса в docker-compose. С хоста та же база доступна как localhost:5432.
DATABASE_URL=postgresql://lkbonch:change-me@db:5432/lkbonch

# Секрет подписи access-токенов. Длинная случайная строка, не пароль от базы.
JWT_SECRET=change-me-too

# Откуда Angular-приложение будет ходить в API на время разработки.
CORS_ORIGINS=http://localhost:4200
